<idea-plugin require-restart="false">
    <id>com.quocnguyen.smartbuildview</id>
    <name>Android + Build Files View</name>
    <version>1.0.1</version>
    <vendor email="ng.baquoc96@gmail.com" url="https://github.com/quocnguyenba">Quoc Nguyen</vendor>
    
    <!-- Specify IDE version compatibility (required) -->
    <idea-version since-build="241"/>

    <description><![CDATA[
    Adds a new "Android + Build" view that shows the same structure as Android view, 
    but with build.gradle, proguard-rules.pro, and consumer-rules.pro visible under each module.
    
    <h3>Usage:</h3>
    <ol>
        <li>Open the Project tool window</li>
        <li>Click the dropdown at the top (where it shows "Android" or "Project")</li>
        <li>Select <b>"Android + Build"</b></li>
    </ol>
    
    <h3>Features:</h3>
    <ul>
        <li>Same structure as Android view (manifests, kotlin+java, res, etc.)</li>
        <li>Build configuration files visible under each module</li>
        <li>No more scrolling to Gradle Scripts!</li>
        <li><b>No restart required</b> - Install and update without restarting your IDE</li>
    </ul>
    ]]></description>

    <depends>com.intellij.modules.platform</depends>
    <depends>com.intellij.modules.java</depends>
    <!-- Android plugin is optional - icons will fall back if not available -->
    <depends optional="true" config-file="android-plugin.xml">org.jetbrains.android</depends>

    <!-- Kotlin K2 mode compatibility -->
    <extensions defaultExtensionNs="org.jetbrains.kotlin">
        <supportsKotlinPluginMode supportsK2="true" supportsK1="true"/>
    </extensions>

    <extensions defaultExtensionNs="com.intellij">
        <!-- Custom "Android + Build" Project View Pane -->
        <projectViewPane implementation="com.quocnguyen.smartbuildview.AndroidBuildViewPane"/>
        
        <!-- Tree Structure Provider for the custom view -->
        <treeStructureProvider implementation="com.quocnguyen.smartbuildview.AndroidBuildTreeStructureProvider"
                               order="first"/>

        <!-- Settings panel (still available in Settings for discoverability) -->
        <projectConfigurable 
            parentId="tools"
            instance="com.quocnguyen.smartbuildview.AndroidBuildViewConfigurable"
            id="com.quocnguyen.smartbuildview.AndroidBuildViewConfigurable"
            displayName="Android + Build View"
            nonDefaultProject="true"/>

        <!-- Settings service is auto-discovered via @Service annotation -->
    </extensions>

    <actions>
        <!-- Settings action in Project View toolbar -->
        <action id="AndroidBuildView.Settings"
                class="com.quocnguyen.smartbuildview.AndroidBuildViewSettingsAction"
                text="Android + Build View Settings"
                description="Configure what to show in Android + Build view"
                icon="AllIcons.General.Settings">
            <add-to-group group-id="ProjectViewToolbar" anchor="last"/>
        </action>
    </actions>
</idea-plugin>
